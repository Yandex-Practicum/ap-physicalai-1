# CPU-образ: Ubuntu + PyTorch CPU + JAX CPU + MuJoCo Playground (без NVIDIA).
# Сборка и запуск: ./scripts/run_container.sh (на хосте без GPU выбирается автоматически)
# или явно: ./scripts/run_container.sh --cpu
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    xvfb \
    x11vnc \
    x11-xserver-utils \
    fluxbox \
    novnc \
    python3-websockify \
    python3 \
    python3-pip \
    libgl1-mesa-glx \
    libgl1-mesa-dev \
    libglu1-mesa \
    libglu1-mesa-dev \
    libosmesa6-dev \
    libglew-dev \
    libglfw3 \
    libglfw3-dev \
    libegl1-mesa-dev \
    wget \
    curl \
    net-tools \
    supervisor \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu

RUN pip3 install --no-cache-dir \
    "playground[learning]==0.1.0"

RUN pip3 install --no-cache-dir \
    jax==0.6.2 \
    jaxlib==0.6.2

RUN pip3 install --no-cache-dir \
    mujoco==3.5.0 \
    mujoco-mjx==3.5.0 \
    gymnasium[mujoco]==1.3.0 \
    numpy==2.2.6 \
    imageio[ffmpeg]==2.37.3 \
    pytest==9.1.1 \
    tensorboard==2.21.0

ENV DISPLAY=:99
ENV MUJOCO_GL=glx
ENV MUJOCO_PLAYGROUND_CPU_MJX_IMPL=jax

COPY environment/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

WORKDIR /workspace

EXPOSE 5900 6080

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
